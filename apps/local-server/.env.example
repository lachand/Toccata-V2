# Copie commentée de ce que make-secrets.sh écrit dans .env (ne versionnez jamais .env).
COUCHDB_ADMIN_PASSWORD=
JWT_SECRET=                      # base64, 32 octets minimum ; identique à couchdb/secrets.ini
SERVER_HOST=classe.example.org   # nom résolu vers le serveur sur le réseau de la classe
SERVER_NAME=Serveur de classe    # affiché dans l'indicateur
TLS_DIRECTIVE=tls internal       # ou : tls /certs/fullchain.pem /certs/privkey.pem
UPSTREAM_COUCHDB_URL=https://cloud.example.org/couch
UPSTREAM_ADMIN_USER=
UPSTREAM_ADMIN_PASSWORD=
TEACHER_IDS=                     # identifiants d'enseignants (22 caractères), séparés par des virgules
