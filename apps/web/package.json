{
  "name": "@toccata/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm i18n:check && tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui extract --clean && node scripts/check-i18n.mjs && lingui compile"
  },
  "dependencies": {
    "@lingui/core": "^6.9.0",
    "@lingui/react": "^6.9.0",
    "@scure/bip39": "^2.4.0",
    "@toccata/ui": "workspace:*",
    "lucide-react": "^1.52.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@lingui/babel-plugin-lingui-macro": "^6.9.0",
    "@lingui/cli": "^6.9.0",
    "@lingui/format-po": "^6.9.0",
    "@lingui/vite-plugin": "^6.9.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "gettext-parser": "^9.1.1",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
