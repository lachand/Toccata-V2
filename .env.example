# Copier vers .env (non versionné). Ne jamais committer de secrets.
# --- CouchDB (docker compose -f infra/docker-compose.yml) ---
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me
# Si Docker Hub est limité en débit :
# COUCHDB_IMAGE=public.ecr.aws/docker/library/couchdb:3.4

# --- Service d'authentification (apps/auth) ---
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=change-me
# Clé HMAC partagée avec CouchDB ([jwt_keys] hmac:<JWT_KID>), 32 octets minimum, en base64.
# Générer : openssl rand -base64 48   — JAMAIS de valeur par défaut : le service refuse de démarrer sans elle.
JWT_SECRET=
JWT_KID=k1
# false uniquement en développement sans HTTPS
COOKIE_SECURE=true
# true uniquement derrière un proxy de confiance (lit X-Forwarded-For)
TRUST_PROXY=false
# L'inscription des enseignants est FERMÉE par défaut. Au choix :
# OPEN_SIGNUP=true            (ouverte à tous : développement seulement)
# Facultatif : code à fournir pour créer un compte enseignant (à distribuer par l'établissement)
# SIGNUP_CODE=
# Facultatif : origine du front en développement (CORS)
# ALLOWED_ORIGIN=http://localhost:5173
