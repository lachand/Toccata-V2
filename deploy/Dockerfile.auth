# Service d'authentification et d'approvisionnement de Toccata (cloud ou serveur de classe).
# Contexte de construction : la RACINE du dépôt.   docker build -f deploy/Dockerfile.auth -t toccata-auth .
ARG NODE_IMAGE=node:22-slim
FROM ${NODE_IMAGE}
ENV NODE_ENV=production
RUN corepack enable
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages ./packages
COPY apps/auth ./apps/auth
# `tsx` fait partie des dépendances : le service s'exécute directement depuis les sources TypeScript
RUN pnpm install --frozen-lockfile --filter @toccata/auth... --prod=false
USER node
EXPOSE 8787
HEALTHCHECK --interval=15s --timeout=4s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8787)+'/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["pnpm", "--filter", "@toccata/auth", "start"]
