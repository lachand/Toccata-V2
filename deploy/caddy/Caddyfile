# Interface, API et CouchDB derrière UNE origine, en HTTPS (obligatoire pour le service worker et l'installation de l'application).
# {$TLS_DIRECTIVE} : vide = certificat Let's Encrypt automatique ; `tls adresse@mail` = idem avec e-mail de contact ;
# `tls internal` = autorité locale de Caddy (serveur de classe, tests) ; `tls /certs/fullchain.pem /certs/privkey.pem` = certificat fourni.
{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
}

{$SERVER_HOST} {
	{$TLS_DIRECTIVE}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; frame-src https:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy auth:8787
	}

	# pas d'interface d'administration (Fauxton) ni de nœud/configuration depuis Internet : l'administration se fait en local
	@couch_admin path /couch/_utils /couch/_utils/* /couch/_node/* /couch/_config/* /couch/_membership
	handle @couch_admin {
		respond 404
	}

	# CouchDB n'est joignable que par ce chemin et avec un jeton valide ; le préfixe /couch est retiré
	handle_path /couch/* {
		reverse_proxy couchdb:5984
	}

	# l'interface : le service worker ne doit jamais être mis en cache longtemps, les fichiers à empreinte le sont pour un an
	handle {
		root * /srv/web
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@shell path /sw.js /index.html /manifest.webmanifest /registerSW.js
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
